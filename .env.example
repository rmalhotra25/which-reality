# Claude / Anthropic API key — required for AI analysis
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Finnhub API key — free at finnhub.io, used for reliable stock data
FINNHUB_API_KEY=your-finnhub-key-here

# Polygon.io API key — required for leveraged-MA signals, day-trade scanner,
# options flow, and the top-rated scanner Polygon price filter
# Get a free key at https://polygon.io (Stocks Starter plan needed for full coverage)
POLYGON_API_KEY=your-polygon-key-here

# Financial Modeling Prep API key — optional, used by 12-Step screener only
# Get a free key at https://financialmodelingprep.com (250 calls/day free tier)
FMP_API_KEY=your-fmp-key-here

# PostgreSQL — set this for persistent storage on Render / production
# Get a free database at https://neon.tech (free tier, no credit card needed)
# Format: postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=postgresql://...

# SQLite fallback — used only when DATABASE_URL is not set (local dev)
DB_PATH=../data/trading.db

# Server port
BACKEND_PORT=8000
